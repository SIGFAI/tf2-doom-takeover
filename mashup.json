  "id": "sigf/tf2-doom-takeover",
  "version": "1.0.0",
  "name": "Doom Takeover",
  "tagline": "Bring Doom into the game in the most visible and funny way. The change shows in the first 30 seconds of play.",
  "how_to_play": [
    "Every TF2 fighter turns into a Doom body: RED are marines, BLU are imps and cacodemons.",
    "Kills explode into blood and flying skulls, with RIP AND TEAR style shouts on screen.",
    "Open the console and type: map koth_viaduct (any map works); bots join and fight on their own.",
    "You watch the match as a spectator while the camera follows the action."
  ],
